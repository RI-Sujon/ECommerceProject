@page
@model Project.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo mb-4">
            <img src="~/css/images/Original.png" alt="E-Bazaar" style="height:48px">
        </div>
        <h2 class="auth-title">Forgot Password</h2>
        <p class="auth-subtitle">Enter your email and we'll send you a reset link</p>

        <div id="auth-error" class="alert alert-danger d-none"></div>
        <div id="auth-success" class="alert alert-success d-none"></div>

        <form id="forgotPasswordForm">
            <div class="mb-4">
                <label class="form-label" style="font-weight:600;text-transform:uppercase;font-size:0.72rem;letter-spacing:0.05em">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text" style="border-color:var(--neutral-200);background:var(--neutral-50)">
                        <i class="fas fa-envelope" style="color:var(--accent)"></i>
                    </span>
                    <input type="email" id="resetEmail" class="form-control" placeholder="you@example.com" required autofocus>
                </div>
            </div>
            <button type="submit" id="resetBtn" class="btn btn-primary w-100" style="height:44px;font-weight:600;font-size:0.9rem">
                <i class="fas fa-paper-plane me-2"></i>Send Reset Link
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/Auth/Login" style="color:var(--accent-dark);font-weight:500;text-decoration:none">
                <i class="fas fa-arrow-left me-1"></i>Back to Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#forgotPasswordForm').on('submit', function (e) {
            e.preventDefault();
            const $btn = $('#resetBtn');
            const $err = $('#auth-error');
            const $ok  = $('#auth-success');
            const email = $('#resetEmail').val().trim();

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Sending...');
            $err.addClass('d-none');
            $ok.addClass('d-none');

            // Simulate sending — backend doesn't have this endpoint yet
            setTimeout(function () {
                $ok.removeClass('d-none').html(
                    '<i class="fas fa-check-circle me-2"></i>' +
                    'If an account exists for <strong>' + email + '</strong>, ' +
                    'we\'ve sent a password reset link. Please check your inbox.'
                );
                $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Send Reset Link');
                $('#resetEmail').val('');
            }, 1500);
        });
    </script>
}
