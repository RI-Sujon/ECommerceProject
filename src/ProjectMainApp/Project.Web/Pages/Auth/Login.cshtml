@page
@model Project.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo mb-4">
            <img src="~/css/images/Original.png" alt="E-Bazaar" style="height:48px">
        </div>
        <h2 class="auth-title">Welcome Back</h2>
        <p class="auth-subtitle">Sign in to your E-Bazaar account</p>

        <div id="auth-error" class="alert alert-danger d-none"></div>
        <div id="session-expired" class="alert alert-warning d-none">
            <i class="fas fa-clock me-2"></i>Your session expired. Please sign in again.
        </div>

        <form id="loginForm">
            <div class="mb-3">
                <label class="form-label" style="font-weight:600;text-transform:uppercase;font-size:0.72rem;letter-spacing:0.05em">Email</label>
                <input type="email" id="loginEmail" class="form-control" placeholder="you@example.com" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label" style="font-weight:600;text-transform:uppercase;font-size:0.72rem;letter-spacing:0.05em">Password</label>
                <div class="input-group">
                    <input type="password" id="loginPassword" class="form-control" placeholder="••••••••" required>
                    <button class="btn btn-outline-secondary" type="button" id="toggleLoginPwd" tabindex="-1">
                        <i class="fas fa-eye" id="loginPwdIcon"></i>
                    </button>
                </div>
                <div class="d-flex justify-content-end mt-1">
                    <a href="/Auth/ForgotPassword" class="small" style="color:var(--accent-dark);text-decoration:none;font-weight:500">Forgot password?</a>
                </div>
            </div>
            <button type="submit" id="loginBtn" class="btn btn-primary w-100" style="height:44px;font-weight:600;font-size:0.9rem">Sign in</button>
        </form>

        <p class="text-center mt-3 text-muted">
            Don't have an account? <a href="/Auth/Register" style="color:var(--accent-dark);font-weight:600">Register</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/Services/AuthService.js"></script>
    <script>
        // Show session-expired banner
        if (new URLSearchParams(location.search).get('reason') === 'expired') {
            document.getElementById('session-expired').classList.remove('d-none');
        }

        // Show / hide password
        $('#toggleLoginPwd').on('click', function () {
            const $pwd = $('#loginPassword');
            const isText = $pwd.attr('type') === 'text';
            $pwd.attr('type', isText ? 'password' : 'text');
            $('#loginPwdIcon').toggleClass('fa-eye fa-eye-slash');
        });

        $('#loginForm').on('submit', async function (e) {
            e.preventDefault();
            const $btn = $('#loginBtn');
            const $err = $('#auth-error');
            $btn.prop('disabled', true).text('Signing in...');
            $err.addClass('d-none');
            try {
                await AuthService.login($('#loginEmail').val(), $('#loginPassword').val());
                window.location.href = '/Product';
            } catch (ex) {
                $err.removeClass('d-none').text(ex.responseJSON?.errorMessage || ex.message || 'Login failed');
            } finally {
                $btn.prop('disabled', false).text('Sign in');
            }
        });
    </script>
}
