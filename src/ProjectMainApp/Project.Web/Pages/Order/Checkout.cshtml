@page
@model Project.Web.Pages.Order.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container px-md-5 py-4">
    <h3 class="page-title"><i class="fas fa-credit-card"></i>Checkout</h3>

    <div id="checkout-container">
        <div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x" style="color:var(--accent)"></i></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Services/CartService.js"></script>
    <script src="~/js/Pages/checkout-page.js"></script>
}
