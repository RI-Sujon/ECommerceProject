@page
@model Project.Web.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="container px-md-5">
    <!-- Hero Banner -->
    <div class="hero-banner mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1" style="color:#fff">Discover Our Collection</h2>
                <p>Find the perfect products curated just for you</p>
            </div>
            <div class="d-none d-md-block">
                <i class="fas fa-gem fa-3x" style="color:rgba(201,169,110,0.3)"></i>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="row align-items-center g-2">
            <div class="col-md-4">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Search products...">
                    <i class="fas fa-search search-icon"></i>
                </div>
            </div>
            <div class="col-md-2">
                <select id="categoryFilter" class="form-select">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="sortFilter" class="form-select">
                    <option value="">Sort: Newest</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="name_asc">Name: A–Z</option>
                    <option value="name_desc">Name: Z–A</option>
                </select>
            </div>
            <div class="col-md-4 text-end d-none" id="admin-add-product-col">
                <button class="add-product-btn admin-add-product-btn">
                    <i class="fas fa-plus me-1"></i> Add Product
                </button>
            </div>
        </div>
    </div>

    <div id="product-container">
        <!-- Products will be loaded here dynamically -->
    </div>
</div>

@section Scripts {
    <script src="~/js/Services/ProductService.js"></script>
    <script src="~/js/Services/CartService.js"></script>
    <script src="~/js/Components/item-card.js"></script>
    <script src="~/js/Components/cart.js"></script>
    <script src="~/js/Components/product-admin-modal.js"></script>
    <script src="~/js/Pages/product-home-page.js"></script>
}