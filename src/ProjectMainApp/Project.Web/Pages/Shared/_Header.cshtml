<header class="main-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center h-100 px-5">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Product/Index">
                <img src="~/css/images/Original.png" alt="Logo" class="logo-image">
            </a>

            <!-- Center Nav Links -->
            <nav class="d-none d-md-flex align-items-center gap-4" id="nav-center-links">
                <a href="/Product" class="header-nav-link">Products</a>
                <a href="/About" class="header-nav-link">About</a>
                <a href="/Contact" class="header-nav-link">Contact</a>
            </nav>

            <div class="d-flex align-items-center gap-2">
                <!-- Auth nav -->
                <div id="nav-auth" class="d-flex align-items-center gap-2">
                    <a href="/Auth/Login" id="nav-login" class="btn btn-sm btn-outline-primary d-none">
                        <i class="fas fa-sign-in-alt me-1"></i>Login
                    </a>
                    <a href="/Auth/Register" id="nav-register" class="btn btn-sm btn-primary d-none">
                        <i class="fas fa-user-plus me-1"></i>Register
                    </a>

                    <!-- Logged-in user dropdown -->
                    <div class="dropdown d-none" id="nav-user-dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="nav-user-btn">
                            <span class="user-avatar-sm" id="nav-user-initial"></span>
                            <span id="nav-user-name" class="d-none d-lg-inline" style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:200px;border:1px solid var(--neutral-200);border-radius:var(--radius-md);box-shadow:var(--shadow-lg);padding:0.5rem 0;margin-top:0.5rem">
                            <li class="px-3 py-2" style="border-bottom:1px solid var(--neutral-200)">
                                <small class="text-muted d-block" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em">Signed in as</small>
                                <span class="fw-semibold small" id="nav-dropdown-name"></span>
                            </li>
                            <li><a class="dropdown-item small" href="/Profile"><i class="fas fa-user me-2" style="width:16px;color:var(--accent)"></i>My Profile</a></li>
                            <li id="nav-dropdown-orders" class="d-none"><a class="dropdown-item small" href="/Order"><i class="fas fa-box me-2" style="width:16px;color:var(--accent)"></i>My Orders</a></li>
                            <li id="nav-dropdown-wishlist" class="d-none"><a class="dropdown-item small" href="/Wishlist"><i class="fas fa-heart me-2" style="width:16px;color:var(--accent)"></i>My Wishlist <span class="badge bg-danger ms-1 wishlist-menu-count" style="font-size:0.6rem"></span></a></li>
                            <li id="nav-dropdown-admin" class="d-none"><a class="dropdown-item small" href="/Admin"><i class="fas fa-cog me-2" style="width:16px;color:var(--accent)"></i>Admin Panel</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item small text-danger" href="#" onclick="Common.logout();return false;"><i class="fas fa-sign-out-alt me-2" style="width:16px"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Dark mode toggle -->
                <button id="dark-mode-toggle" class="btn btn-sm btn-outline-secondary"
                        title="Toggle dark mode" onclick="toggleDarkMode()">
                    <i id="dark-mode-icon" class="fas fa-moon"></i>
                </button>

                <!-- Wishlist & Cart icons -->
                <div id="cart-icon-wrapper" class="cart-icon">
                    <a href="/Wishlist" id="wishlist-icon-btn" class="btn btn-link position-relative d-none" title="My Wishlist" style="text-decoration:none">
                        <i class="fas fa-heart fs-5"></i>
                        <span class="wishlist-count" style="position:absolute;top:0;right:0;background:var(--danger);color:#fff;border-radius:50%;width:18px;height:18px;font-size:0.65rem;display:none;align-items:center;justify-content:center;font-weight:700">0</span>
                    </a>
                    <div id="cart-icon-btn" class="btn btn-link position-relative" title="Shopping Cart">
                        <i class="fas fa-shopping-cart fs-5"></i>
                        <span class="cart-count">0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    function toggleDarkMode() {
        const html = document.documentElement;
        const isDark = html.getAttribute('data-bs-theme') === 'dark';
        const next = isDark ? 'light' : 'dark';
        html.setAttribute('data-bs-theme', next);
        localStorage.setItem('darkMode', next);
        document.getElementById('dark-mode-icon').className = isDark ? 'fas fa-moon' : 'fas fa-sun';
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Sync icon with current theme
        if (document.documentElement.getAttribute('data-bs-theme') === 'dark') {
            const icon = document.getElementById('dark-mode-icon');
            if (icon) icon.className = 'fas fa-sun';
        }

        // Auth nav
        if (Common.isLoggedIn()) {
            const info = Common.getUserInfo();
            const initial = (info.fullName || info.username || 'U').charAt(0).toUpperCase();
            const displayName = info.fullName || info.username;

            // Show dropdown
            document.getElementById('nav-user-dropdown').classList.remove('d-none');
            document.getElementById('nav-user-initial').textContent = initial;
            document.getElementById('nav-user-name').textContent = displayName;
            document.getElementById('nav-dropdown-name').textContent = displayName;

            if (info.role === 'Admin') {
                document.getElementById('nav-dropdown-admin').classList.remove('d-none');
                document.getElementById('cart-icon-wrapper').classList.add('d-none');
            } else {
                document.getElementById('nav-dropdown-orders').classList.remove('d-none');
                document.getElementById('nav-dropdown-wishlist').classList.remove('d-none');
                // Show wishlist icon
                const wlBtn = document.getElementById('wishlist-icon-btn');
                if (wlBtn) {
                    wlBtn.classList.remove('d-none');
                    const wlCount = wlBtn.querySelector('.wishlist-count');
                    if (wlCount && typeof WishlistService !== 'undefined') {
                        const c = WishlistService.count();
                        wlCount.textContent = c;
                        wlCount.style.display = c > 0 ? 'flex' : 'none';
                    }
                }
            }
        } else {
            document.getElementById('nav-login').classList.remove('d-none');
            document.getElementById('nav-register').classList.remove('d-none');
        }

        // Highlight active nav link
        const path = window.location.pathname;
        document.querySelectorAll('.header-nav-link').forEach(link => {
            if (path.startsWith(link.getAttribute('href'))) {
                link.classList.add('active');
            }
        });
    });
</script>